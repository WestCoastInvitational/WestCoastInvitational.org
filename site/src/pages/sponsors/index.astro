---
import SubPage from "../../layouts/SubPage.astro";
import { presentingSponsors, eventSponsors, type Sponsor } from "../../data/sponsors";
import { links } from "../../data/links";
import { url } from "../../lib/url";

const tiers: { id: string; title: string; list: Sponsor[] }[] = [
  { id: "presenting", title: "Presenting sponsor", list: presentingSponsors },
  { id: "event", title: "Event sponsors", list: eventSponsors },
];
const mail = `mailto:${links.email}?subject=Sponsoring%20WCI%20'27`;
---
<SubPage tone="white">
  {tiers.map((tier) => (
    <section class:list={["sponsortier", `sponsortier--${tier.id}`]}>
      <h2>{tier.title}</h2>
      {tier.list.length ? (
        <ul>
          {tier.list.map((s) => {
            const mark = s.logo ? <img src={url(s.logo)} alt={s.name} /> : s.name;
            return <li>{s.url ? <a href={s.url} target="_blank" rel="noopener">{mark}</a> : mark}</li>;
          })}
        </ul>
      ) : (
        <p class="soon">Announcing soon</p>
      )}
    </section>
  ))}
  <section class="sponsorcta">
    <h2>Become a sponsor</h2>
    <p>Want your name in front of every team at WCI '27? Email the WCI team to get started.</p>
    <div class="actions">
      <a class="btn btn--dusk" href={mail}>Email us</a>
      <a class="link" href={url("/sponsors/become")}>Sponsorship details</a>
    </div>
  </section>
</SubPage>
